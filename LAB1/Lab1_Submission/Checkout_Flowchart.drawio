<mxfile host="app.diagrams.net" agent="Mozilla/5.0" version="24.7.7" type="device">
  <diagram name="Checkout Flow" id="flow-checkout-place-order">
    <mxGraphModel dx="1420" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="n1" value="Start" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="140" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="Shopper opens cart and selects &quot;Checkout&quot;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="120" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="All cart items&#10;still in stock?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="320" y="205" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n3b" value="Show &quot;item unavailable&quot;, drop the item, return Shopper to cart" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="212" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="endReturn" value="End &#8211; back to cart (no order)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="610" y="320" width="160" height="46" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="Reserve stock quantities for the order" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="330" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="Show order summary grouped by vendor (item earnings, 5% platform commission, shipping, total)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="405" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="Shopper confirms shipping address" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="500" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="Shopper selects payment method and selects &quot;Pay&quot;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="575" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="Send total and per-vendor split to Payment Gateway" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="655" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="Payment&#10;authorised?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="320" y="735" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n9d" value="Attempts&#10;so far &lt; 2?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="590" y="735" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n9retry" value="Prompt Shopper for another payment method" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="600" y="590" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n9cancel" value="Cancel checkout, release reserved stock, keep cart intact" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="860" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="endFail" value="End &#8211; payment failed (no money held)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="610" y="955" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="n10" value="Gateway captures total, transfers each vendor share (earnings &#8722; 5%) and the commission to the platform" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="865" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="Create one order per vendor (status: Paid &#8211; Awaiting Shipment); mark each payout &quot;Held&quot;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="960" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="Reduce stock by ordered quantities and clear the cart" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="1055" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n13" value="Notify each vendor of the new order; email receipt to Shopper" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="1135" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n14" value="Show confirmation page with per-vendor breakdown" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="1215" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="endOk" value="End &#8211; order placed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="340" y="1295" width="140" height="46" as="geometry" />
        </mxCell>

        <mxCell id="f1" style="endArrow=block;html=1;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" style="endArrow=block;html=1;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3no" value="No" style="endArrow=block;html=1;" edge="1" parent="1" source="n3" target="n3b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3b" style="endArrow=block;html=1;" edge="1" parent="1" source="n3b" target="endReturn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3yes" value="Yes" style="endArrow=block;html=1;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4" style="endArrow=block;html=1;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5" style="endArrow=block;html=1;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f6" style="endArrow=block;html=1;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f7" style="endArrow=block;html=1;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f8" style="endArrow=block;html=1;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f9no" value="No" style="endArrow=block;html=1;" edge="1" parent="1" source="n9" target="n9d"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f9yes" value="Yes" style="endArrow=block;html=1;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f9dyes" value="Yes (retry)" style="endArrow=block;html=1;" edge="1" parent="1" source="n9d" target="n9retry"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f9retry" style="endArrow=block;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="n9retry" target="n7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f9dno" value="No" style="endArrow=block;html=1;" edge="1" parent="1" source="n9d" target="n9cancel"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f9cancel" style="endArrow=block;html=1;" edge="1" parent="1" source="n9cancel" target="endFail"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f10" style="endArrow=block;html=1;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f11" style="endArrow=block;html=1;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f12" style="endArrow=block;html=1;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f13" style="endArrow=block;html=1;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f14" style="endArrow=block;html=1;" edge="1" parent="1" source="n14" target="endOk"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
